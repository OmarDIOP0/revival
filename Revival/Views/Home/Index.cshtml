@using System.Globalization
@using Microsoft.Extensions.Options
@using Revival.Configuration
@inject IViewLocalizer Localizer
@inject IOptions<SiteSettings> SiteOptions
@inject IOptions<List<TeamMember>> TeamOptions
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var site = SiteOptions.Value;
    var isFr = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "fr";
    var teamPreview = (TeamOptions.Value ?? new List<TeamMember>())
        .Where(m => m.IsPublishable)
        .Take(3)
        .ToList();
    var phoneHref = "tel:" + site.Phone.Replace(" ", "");
}

<section class="container hero">
    <div class="hero__intro">
        <h1>@Localizer["Hero_Title"]</h1>
        <p class="text-lg">@Localizer["Hero_Subtitle"]</p>
        <div class="hero__actions">
            <a class="btn btn-primary" asp-controller="Contact" asp-action="Index">@Localizer["Cta_Book"]</a>
            <a class="btn btn-secondary" href="@phoneHref">@Localizer["Cta_Call"]</a>
        </div>
    </div>
    <figure class="hero__figure">
        <picture>
            <source type="image/webp"
                    srcset="/img/derived/home-hero-900.webp 900w, /img/derived/home-hero-1600.webp 1600w, /img/derived/home-hero-2400.webp 2400w"
                    sizes="100vw" />
            <img src="/img/derived/home-hero-1600.jpg"
                 srcset="/img/derived/home-hero-900.jpg 900w, /img/derived/home-hero-1600.jpg 1600w, /img/derived/home-hero-2400.jpg 2400w"
                 sizes="100vw"
                 width="1600" height="900"
                 alt="@Localizer["Hero_ImageAlt"]"
                 fetchpriority="high" />
        </picture>
    </figure>
</section>

<section class="stats" aria-label="@Localizer["Stat_Beds"]">
    <div class="container stats__row">
        <div class="stat">
            <div class="stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="stat-ring__track" cx="60" cy="60" r="48" />
                    <circle class="stat-ring__fill" cx="60" cy="60" r="48"
                            stroke-dasharray="301.6" stroke-dashoffset="135.7" />
                </svg>
                <span class="stat-ring__value">@site.Beds</span>
            </div>
            <p class="stat__label">@Localizer["Stat_Beds"]</p>
        </div>
        <div class="stat">
            <div class="stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="stat-ring__track" cx="60" cy="60" r="48" />
                    <circle class="stat-ring__fill" cx="60" cy="60" r="48"
                            stroke-dasharray="301.6" stroke-dashoffset="211.1" />
                </svg>
                <span class="stat-ring__value">@site.VipRooms</span>
            </div>
            <p class="stat__label">@Localizer["Stat_Vip"]</p>
        </div>
        <div class="stat">
            <div class="stat-ring">
                <svg viewBox="0 0 120 120" aria-hidden="true">
                    <circle class="stat-ring__track" cx="60" cy="60" r="48" />
                    <circle class="stat-ring__fill" cx="60" cy="60" r="48"
                            stroke-dasharray="301.6" stroke-dashoffset="60.3" />
                </svg>
                <span class="stat-ring__value">60</span>
            </div>
            <p class="stat__label">@Localizer["Stat_PatientsPerDay"]</p>
        </div>
    </div>
</section>

<section class="container split">
    <div class="split__media">
        <picture>
            <source type="image/webp"
                    srcset="/img/derived/home-care-700.webp 700w, /img/derived/home-care-1400.webp 1400w"
                    sizes="(min-width: 768px) 40vw, 100vw" />
            <img src="/img/derived/home-care-700.jpg"
                 srcset="/img/derived/home-care-700.jpg 700w, /img/derived/home-care-1400.jpg 1400w"
                 sizes="(min-width: 768px) 40vw, 100vw"
                 width="700" height="1050"
                 alt="@Localizer["Care_ImageAlt"]"
                 loading="lazy" />
        </picture>
    </div>
    <div class="split__body">
        <h2>@Localizer["Care_Title"]</h2>
        <p>@Localizer["Care_Body"]</p>
        <a class="btn btn-secondary" asp-controller="Care" asp-action="Index">@Localizer["Care_Link"]</a>
    </div>
</section>

<section class="container team-teaser">
    <div class="team-teaser__intro">
        <h2>@Localizer["Team_Title"]</h2>
        <p>@Localizer["Team_Body"]</p>
    </div>
    @if (teamPreview.Any())
    {
        <div class="team-teaser__grid">
            @foreach (var member in teamPreview)
            {
                var role = isFr ? member.RoleFr : member.RoleEn;
                var initials = string.Concat(member.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p[0])).ToUpperInvariant();
                if (initials.Length > 2) { initials = initials[..2]; }
                <div class="team-card">
                    <div class="team-card__avatar" aria-hidden="true">
                        @if (!string.IsNullOrWhiteSpace(member.Photo))
                        {
                            <img src="~/img/@member.Photo" alt="" loading="lazy" />
                        }
                        else
                        {
                            @initials
                        }
                    </div>
                    <p class="team-card__name">@member.Name</p>
                    <p class="team-card__role">@role</p>
                </div>
            }
        </div>
    }
    <p style="margin-top: var(--space-6);">
        <a class="btn btn-secondary" asp-controller="Team" asp-action="Index">@Localizer["Team_Link"]</a>
    </p>
</section>

<section class="foundation-teaser">
    <div class="container foundation-teaser__inner">
        <h2>@Localizer["Foundation_Title"]</h2>
        <p>@Localizer["Foundation_Body"]</p>
        <a class="btn btn-secondary" asp-controller="Foundation" asp-action="Index">@Localizer["Foundation_Link"]</a>
    </div>
</section>
